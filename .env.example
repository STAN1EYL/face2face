# Perxona Connect — region-specific，presenter CDN 會依此推導 region
PERXONA_API_BASE_URL=https://console.perxona.ai/asia

# Perxona Connect API keys（Console > Organization > Integration > Connect API keys）
# SECRET      = server only，allowed domains 留空
# PUBLISHABLE = 交給瀏覽器的 presenter，allowed domains 要填部署網域
PERXONA_CONNECT_SECRET_KEY=
PERXONA_CONNECT_PUBLISHABLE_KEY=

# 選填：覆寫 presenter engine URL（region 必須與上方一致）
# PRESENTER_URL=https://cdn.perxona.ai/asia/prod/latest/widget/entry/presenter.js

# LLM（Face2Face 談判引擎）
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
